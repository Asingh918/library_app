<h1 class="mb-4">Subject: <%= @subject.name %></h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
  <% @books.each do |book| %>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title"><%= book.title %></h5>
          <p class="text-muted">
            <small><%= book.authors.map(&:name).join(', ') %></small>
          </p>
        </div>
        <div class="card-footer">
          <%= link_to "View Details", book_path(book),
              class: "btn btn-sm btn-outline-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-4"><%= paginate @books %></div>

<%= link_to "← All Subjects", subjects_path,
    class: "btn btn-outline-secondary mt-3" %>