<h1 class="mb-4">All Books</h1>

<form action="/books" method="get" class="row g-2 mb-4">
  <div class="col-md-6">
    <input type="text" name="search" class="form-control"
           placeholder="Search books..." value="<%= params[:search] %>">
  </div>
  <div class="col-md-4">
    <select name="subject_id" class="form-select">
      <option value="">All Subjects</option>
      <% @subjects.each do |subject| %>
        <option value="<%= subject.id %>"
                <%= 'selected' if params[:subject_id] == subject.id.to_s %>>
          <%= subject.name %>
        </option>
      <% end %>
    </select>
  </div>
  <div class="col-md-2">
    <button type="submit" class="btn btn-primary w-100">Search</button>
  </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
  <% @books.each do |book| %>
    <div class="col">
      <div class="card h-100">
        <% if book.cover_url.present? %>
          <img src="<%= book.cover_url %>" class="card-img-top"
               style="height: 200px; object-fit: cover;">
        <% else %>
          <div class="bg-secondary d-flex align-items-center justify-content-center"
               style="height: 200px;">
            <span class="text-white fs-1">📚</span>
          </div>
        <% end %>
        <div class="card-body">
          <h5 class="card-title"><%= book.title %></h5>
          <p class="card-text text-muted">
            <small>
              <%= book.authors.map(&:name).join(', ') %><br>
              <% if book.subject.present? %>
                <span class="badge bg-secondary"><%= book.subject.name %></span>
              <% end %>
              <% if book.first_publish_year.present? %>
                · <%= book.first_publish_year %>
              <% end %>
            </small>
          </p>
        </div>
        <div class="card-footer">
          <%= link_to "View Details", book_path(book), class: "btn btn-sm btn-outline-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-4">
  <%= paginate @books %>
</div>